# .env.example — root-level master reference for every environment variable used anywhere
# in this repository. Every value below is intentionally left blank. Fill in the REAL files
# on the VM (never a copy of this file with real values, and never commit real values
# anywhere in this repo).
#
# Two real env files exist on the VM, both should be root-only, mode 0600:
#   /etc/valheim-alert.env    — Discord webhook + Hermóðr bot config. The template for this
#                                one is tracked at azure/dashboard/valheim-alert.env and is
#                                installed to /etc/valheim-alert.env by install-dashboard.sh
#                                the first time it runs (it never overwrites it afterward).
#   /etc/valheim-server.env   — server identity / dashboard / off-site backup config.
# This file mirrors both so every variable the repo reads is visible in one place; the
# section headers below say which real file each one belongs in.
#
# Sourced by grepping the tree for os.environ.get(...) / os.environ[...] calls in
# azure/dashboard/*.py — see that section's variables for what's actually read today.
# The "server identity" section further down documents variables this repo's automation and
# documentation refer to by name (server name, world name, dashboard hostname, etc.) that
# are still hardcoded directly inside azure/cloud-init.yaml, azure/dashboard/Caddyfile, and
# azure/dashboard/valheim-offsite-backup.sh in this snapshot rather than read from the
# environment — see the comment on each one below and docs/OPERATIONS.md's deploy steps for
# exactly where to edit them today.

# ---------------------------------------------------------------------------
# Discord alerts + live status board   (file: /etc/valheim-alert.env)
# Read by: valheim-alert.py, valheim-digest.py, valheim-medals.py
# ---------------------------------------------------------------------------

# Discord webhook URL the alert/digest/medals scripts post to.
# Obtain: Discord channel > Edit Channel > Integrations > Webhooks > New Webhook > Copy Webhook URL.
# Required for any Discord output (alerts, live status board, weekly digest, medals posts) --
# leave blank to disable Discord entirely; everything that would post just stays quiet.
DISCORD_WEBHOOK_URL=

# 1 = also announce every player arrival/departure; unset/0 = only post alerts + board updates.
# Optional. Read by valheim-alert.py; defaults to off if unset.
ALERT_JOINS=

# Public dashboard URL, included as a link in Discord messages.
# Optional, cosmetic only -- omit if you aren't running the dashboard.
DASHBOARD_URL=

# ---------------------------------------------------------------------------
# Hermóðr, the Discord Q&A bot and restart-approval relay   (file: /etc/valheim-bot.env)
# Read by: valheim-bot.py
# This used to live in /etc/valheim-alert.env; it split into its own file (task R2, de-root) so
# the alert/medals/digest scripts -- which need DISCORD_WEBHOOK_URL -- and this process -- which
# never touches that webhook -- don't share a credential neither one of them needs from the other.
# The template for this file is tracked at azure/dashboard/valheim-bot.env.
# All variables in this section are required together to enable Hermóðr. Leaving
# DISCORD_BOT_TOKEN blank makes valheim-bot.service log one line and exit 0 immediately --
# no crash loop, and nothing else in this section matters until it's set.
# ---------------------------------------------------------------------------

# Discord bot token.
# Obtain: create an application + bot user at https://discord.com/developers/applications,
# enable the "Message Content" privileged intent, invite it to your server with the `bot`
# scope and the Send Messages / Read Message History permissions.
# Required to enable Hermóðr; leave blank to leave the bot disabled.
DISCORD_BOT_TOKEN=

# The one channel Hermóðr will ever read or answer in -- everything else, including DMs, is
# ignored before any parsing or AI call happens.
# Obtain: enable Developer Mode in Discord settings, then right-click the channel > Copy Channel ID.
# Prefer this over HERMODR_CHANNEL_NAME -- an ID survives a channel rename, a name doesn't.
# Required if DISCORD_BOT_TOKEN is set and HERMODR_CHANNEL_NAME is left blank.
HERMODR_CHANNEL_ID=

# Fallback: exact channel name, resolved once at bot startup. Only consulted if
# HERMODR_CHANNEL_ID is blank. Optional.
HERMODR_CHANNEL_NAME=

# Azure AI Foundry chat-completions endpoint. Auth is the VM's system-assigned managed
# identity -- no API key is ever read, stored, or logged by this bot.
# Obtain: the endpoint URL of your Azure AI Foundry project/deployment.
# Required if DISCORD_BOT_TOKEN is set.
HERMODR_AI_ENDPOINT=

# Model deployment name within that Azure AI Foundry project. Change only this value to
# point Hermóðr at a different model, then restart valheim-bot.service.
# Required if DISCORD_BOT_TOKEN is set.
HERMODR_AI_MODEL=

# ---------------------------------------------------------------------------
# Restart approval (see PLAN-v5.md "The spool" / "Request state machine")   (file: /etc/valheim-bot.env)
# Read by: valheim-bot.py. Fails closed: leave any one of these three blank and the bot never
# reads the restart spool, never posts an approval request, and never writes a verdict -- it
# logs one line explaining why and stops there.
# ---------------------------------------------------------------------------

# The guild both HERMODR_CHANNEL_ID above and RESTART_APPROVAL_CHANNEL_ID below belong to. Every
# approval interaction is re-checked against this id server-side even though Discord already
# scopes interactions to a guild.
# Obtain: enable Developer Mode in Discord settings, then right-click the server icon > Copy Server ID.
HERMODR_GUILD_ID=

# A SEPARATE, role-restricted Discord channel -- never HERMODR_CHANNEL_ID above -- so non-hall
# members never even see the Approve/Deny buttons.
# Obtain: same as HERMODR_CHANNEL_ID above (right-click the channel > Copy Channel ID). Numeric only.
RESTART_APPROVAL_CHANNEL_ID=

# The Discord role allowed to click Approve/Deny. Never a role name -- names can be renamed or
# duplicated, ids cannot. Anyone with Manage Roles in the guild can grant themselves this role, so
# configuring it means Discord server-admin implies restart-approval authority; that is accepted.
# Obtain: Server Settings > Roles > the role > ... > Copy Role ID (Developer Mode on).
RESTART_APPROVER_ROLE_ID=

# ---------------------------------------------------------------------------
# Server identity / dashboard / off-site backup   (file: /etc/valheim-server.env)
# NOTE: in this snapshot of the code these values are hardcoded directly into
# azure/cloud-init.yaml, azure/dashboard/Caddyfile, azure/dashboard/valheim-status-collect.py
# and azure/dashboard/valheim-offsite-backup.sh rather than read from the environment -- see
# docs/OPERATIONS.md's "Deploy your own" steps for the exact file/line to edit for each until
# they're wired up to be read from here.
# ---------------------------------------------------------------------------

# The Valheim server's name, as it appears in the in-game Community server list.
# Required. Currently: the -name flag on valheim.service's ExecStart= in cloud-init.yaml.
SERVER_NAME=

# The world/save name -- also the folder name under worlds_local/ on the VM.
# Required. Currently: the -world flag on the same ExecStart= line.
WORLD_NAME=

# The address players connect to (host:port), shown on the dashboard's Connect info.
# Required if you want the dashboard to show correct join info.
SERVER_ADDRESS=

# The dashboard's public hostname -- what you point DNS at and what belongs in the site
# block at the top of Caddyfile.
# Required only if you deploy the dashboard. Currently: hardcoded at the top of
# azure/dashboard/Caddyfile.
DASHBOARD_HOST=

# A Discord server invite code (the part after discord.gg/), shown on the dashboard as a
# join link and used to fetch the live member/online count.
# Obtain: Discord server > Invite People > copy the code from the generated invite link.
# Optional -- omit if you don't want a Discord link/count on the dashboard. Currently:
# hardcoded in azure/dashboard/valheim-status-collect.py.
DISCORD_INVITE=

# Azure Storage account name that off-site world backups upload to. Auth is the VM's managed
# identity (needs the Storage Blob Data Contributor role on this account) -- no storage key
# or connection string is ever read, stored, or logged.
# Required only if you enable valheim-offsite.timer. Currently: hardcoded near the top of
# azure/dashboard/valheim-offsite-backup.sh.
OFFSITE_ACCOUNT=

# ---------------------------------------------------------------------------
# Advanced: on-disk path overrides   (file: /etc/valheim-alert.env)
# Read by: valheim-bot.py, valheim-medals.py
# All of these have working defaults baked into the scripts and only matter if you're
# running more than one instance on the same box or deliberately relocating state. Safe to
# leave every one of these blank.
# ---------------------------------------------------------------------------

# Where valheim-bot.py logs to. Default: /var/log/hermodr.log
HERMODR_LOG=

# Which systemd unit Hermóðr treats as "the game server" when answering status questions.
# Default: /etc/systemd/system/valheim.service
HERMODR_VALHEIM_UNIT=

# valheim-medals.py's own state/input files. Defaults live under /var/www/valheim,
# /var/lib/valheim-status, and /var/log -- see the top of azure/dashboard/valheim-medals.py.
MEDALS_STATUS=
MEDALS_EVENTS=
MEDALS_SAMPLES=
MEDALS_STATE=
MEDALS_ALERTS=
MEDALS_WEB_OUT=
MEDALS_LOG=

# Advanced restart-executor tuning (valheim-restartd.py RESTARTD_*, valheim-restart-exec.py VR_*; ~47 vars, all with working defaults, all in /etc/valheim-alert.env) is intentionally not mirrored here -- see docs/RESTART-TUNING.md.
