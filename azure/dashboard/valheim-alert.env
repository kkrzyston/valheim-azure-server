# Discord alerts for the Valheim dashboard. Read by valheim-status.service every minute
# (valheim-alert.py) and by valheim-digest.timer once a week (valheim-digest.py) -- both
# read this same file.
# Create the webhook in Discord: channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
DISCORD_WEBHOOK_URL=
# 1 = also announce when Vikings arrive and leave (no @everyone; the bot never pings anyone)
ALERT_JOINS=1
# Dashboard link included in messages -- should be https:// + the same DASHBOARD_HOST you set
# in /etc/valheim-server.env. Leave empty to omit the link from Discord messages.
DASHBOARD_URL=

# valheim-alert.py also keeps one Discord message ("the board") edited every minute with the
# live status, and posts (no separate toggle needed -- they read status.json fields that only
# exist once the corresponding v4 collector/backup pieces are deployed, and stay silent until
# then): raids, a boss falling, Viking hours/deaths/sessions milestones, a new
# Viking joining the roster, Azure scheduled-maintenance notices, and an off-site-backup-behind
# warning. valheim-digest.py posts one weekly summary embed on its own timer -- it does not run
# from valheim-status.service, so it is not on the once-a-minute path.

# Hermodr (valheim-bot.py, valheim-bot.service) -- the Discord Q&A bot and restart-approval
# relay -- no longer reads this file. It runs as its own unprivileged user now (task R2, de-root)
# and reads its own template instead: see valheim-bot.env, installed as /etc/valheim-bot.env.
# DISCORD_BOT_TOKEN, HERMODR_CHANNEL_ID/_NAME, HERMODR_GUILD_ID, HERMODR_AI_ENDPOINT/_MODEL,
# HERMODR_LOG, and the RESTART_APPROVAL_* settings all live there now, not here.
