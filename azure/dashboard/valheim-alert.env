# Discord alerts for the Valheim dashboard. Read by valheim-status.service every minute
# (valheim-alert.py) and by valheim-digest.timer once a week (valheim-digest.py) -- both
# read this same file.
# Create the webhook in Discord: channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
DISCORD_WEBHOOK_URL=
# 1 = also announce when Vikings arrive and leave (no @everyone; the bot never pings anyone)
ALERT_JOINS=1
# Dashboard link included in messages
DASHBOARD_URL=https://valheim-1g49ye.westus2.cloudapp.azure.com

# valheim-alert.py also keeps one Discord message ("the board") edited every minute with the
# live status, and posts (no separate toggle needed -- they read status.json fields that only
# exist once the corresponding v4 collector/backup pieces are deployed, and stay silent until
# then): raids, a boss falling, Viking hours/deaths/sessions milestones, a new
# Viking joining the roster, Azure scheduled-maintenance notices, and an off-site-backup-behind
# warning. valheim-digest.py posts one weekly summary embed on its own timer -- it does not run
# from valheim-status.service, so it is not on the once-a-minute path.

# Hermodr (valheim-bot.py, valheim-bot.service) -- the Discord Q&A bot. Empty DISCORD_BOT_TOKEN
# means the service logs a line and exits 0 immediately (no crash loop); nothing else below matters
# until it is set. See azure/README.md "Hermodr" for full setup and the security model.
DISCORD_BOT_TOKEN=
# The only channel Hermodr will ever answer in. Prefer the numeric id (right-click the channel in
# Discord with Developer Mode on > Copy Channel ID) over the name -- the id can't be renamed out
# from under it. HERMODR_CHANNEL_NAME is only a fallback, resolved once at startup by exact name.
HERMODR_CHANNEL_ID=
HERMODR_CHANNEL_NAME=
# Azure AI Foundry chat-completions endpoint and model deployment name. Auth is the VM's managed
# identity (no API key stored anywhere) -- swap HERMODR_AI_MODEL alone to point at a different
# deployment; leave HERMODR_AI_ENDPOINT unset to use the ai-valheim project's default endpoint.
HERMODR_AI_ENDPOINT=
HERMODR_AI_MODEL=
