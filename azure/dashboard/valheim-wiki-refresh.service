[Unit]
Description=Valheim wiki knowledge base: refresh the corpus (ingest) and rebuild the search index
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Two steps, deliberately NOT dash-prefixed: if the ingest step fails, the index-build step must
# not run at all, so a bad or half-written wiki-records.jsonl is never read into a rebuilt wiki.db.
# The exit-code contract with valheim-wiki-ingest.py (PLAN-v6 W1) IS nailed down in code now
# (confirmed against the real script, see its module docstring's FAILURE POLICY section): exit 0
# whenever a corpus file was successfully written, however many pages were logged as skipped
# (skips never affect the exit code on a successful write -- only the journal/SUMMARY line does);
# non-zero ONLY on a hard failure -- too few pages attempted to be plausible evidence of a real
# run, more than 5% of attempted pages failing to parse, or the output file itself being
# unwritable -- and in every one of those cases nothing is written. Do not dash-prefix either
# ExecStart line to "fix" a future non-zero exit: that would hide a real hard failure from
# `systemctl status`/the journal instead of correctly skipping the reindex below.
#
# Both paths are passed EXPLICITLY here rather than relying on either script's own default (C2
# review fix): valheim-wiki-ingest.py's --out used to default to its own install directory
# (/usr/local/sbin, read-only under ProtectSystem=strict below), which made the very first write
# of every run raise PermissionError -- silently skipping the index-build line below every single
# time, forever, with no unit-level symptom beyond "the corpus never updates." The ingest script
# also now supports the same VALHEIM_WIKI_ROOT env-var convention valheim-wiki-index.py already
# used (see both scripts' own comments near their default paths), so these explicit flags and
# that env var agree even if one of them is ever dropped by accident.
ExecStart=/opt/valheim-wiki/venv/bin/python /usr/local/sbin/valheim-wiki-ingest.py --out=/var/lib/valheim-wiki/wiki-records.jsonl --dump-path=/var/lib/valheim-wiki/fandom-dump.xml
# Stdlib only (sqlite3/json/re per PLAN-v6 W2), so this runs under the system interpreter, not the
# ingest venv -- same split as the collector scripts vs. Hermodr's own venv below.
ExecStart=/usr/bin/python3 /usr/local/sbin/valheim-wiki-index.py /var/lib/valheim-wiki/wiki-records.jsonl --db /var/lib/valheim-wiki/wiki.db
Nice=10
# The ordinary walk is ~2,200 pages (1,179 Weird Gloop + Fandom's delta) fetched serially with
# maxlag=5 and backoff on 429/503, plus downloading and decompressing Fandom's ~1.16 MB dump and
# parsing every page with mwparserfromhell. That can comfortably run past Type=oneshot's default
# 90 s TimeoutStartSec (see valheim-restart-exec.service for the same reasoning) -- give it room.
TimeoutStartSec=3600

# Runs as the same unprivileged, nologin system account as Hermodr (see valheim-bot.service) --
# there is no reason for a wiki-fetching batch job to run as root either, and it writes only its
# own corpus directory.
User=valheim-bot
Group=valheim-bot

# Hardening. Mirrors valheim-bot.service (same account, same "unprivileged process making outbound
# HTTPS calls" shape) rather than valheim-restartd.service: restartd's PrivateNetwork=yes +
# IPAddressDeny=any is the wrong template here on purpose -- this process's entire job is fetching
# from weirdgloop.org, fandom.com and S3 over the public internet, and that pairing would make
# every request fail with no route to host (see valheim-restartd.service's own warning comment
# about what breaks if its network-denial directives are copied onto a unit that needs a network).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The only path this process may write to: the wiki corpus (wiki-records.jsonl and wiki.db, the
# latter via the index builder's own tmp-file-then-os.replace() swap per PLAN-v6 W2, so a reader
# -- Hermodr's search() -- never sees a half-built index).
ReadWritePaths=/var/lib/valheim-wiki
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @module @raw-io @reboot @swap @mount
# AF_INET/AF_INET6 for the wiki/S3 fetches, AF_UNIX for local name resolution -- same three as
# valheim-bot.service, which already proved this is the minimal set an outbound-HTTPS process on
# this box needs.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
MemoryMax=512M
TasksMax=64
