# valheim-server.env.example -- template for /etc/valheim-server.env on the VM.
#
# Copy this file to /etc/valheim-server.env and fill in the values for your own deployment,
# then:
#   sudo chown root:root /etc/valheim-server.env
#   sudo chmod 0600 /etc/valheim-server.env
#
# This file is read by the dashboard's Python scripts (valheim-status-collect.py,
# valheim-world-scan.py, valheim-alert.py, valheim-digest.py, valheim-medals.py, valheim-bot.py)
# via each systemd unit's `EnvironmentFile=-/etc/valheim-server.env`, and by the shell scripts
# that need WORLD_NAME / OFFSITE_ACCOUNT (they `source` it directly). It is separate from
# /etc/valheim-alert.env (Discord webhook + alert toggles) and /etc/valheim-bot.env (Hermodr's
# own token/model settings) -- this file holds the identity/naming values every script shares.
#
# Leave a value empty to disable the feature it controls (see the per-variable notes below) --
# do not fill in a fake value just to avoid a blank line.

# The Valheim server's display name -- what you passed to `-name` on the game server's
# ExecStart line (see cloud-init.yaml / valheim.service). Shows in the Steam server browser
# and in dashboard/Discord text.
SERVER_NAME=

# The world save name -- what you passed to `-world` on the game server's ExecStart line.
# Determines the save file directory the dashboard reads: /home/valheim/data/worlds_local/$WORLD_NAME
WORLD_NAME=

# host:port shown to players for "Join IP" (e.g. 20.1.2.3:2456 or a DNS name:2456). This is
# your VM's public IP or DNS label plus the game port. Leave empty to hide the address on the
# dashboard and in Hermodr's join-instructions reply, rather than show a placeholder.
SERVER_ADDRESS=

# The dashboard's public hostname (e.g. valheim-<yourlabel>.<region>.cloudapp.azure.com), without
# the https:// scheme. Used to build dashboard links in Discord embeds. Leave empty to omit
# those links.
DASHBOARD_HOST=

# Your Discord server's invite code only (the part after https://discord.gg/ -- not the full
# URL). Create one from Discord: Server Settings > Invites > Create Invite (set "Expire after"
# to Never for a stable link). Leave empty to disable the Discord member/online-count card on
# the dashboard entirely -- the dashboard hides that element rather than showing a broken link.
DISCORD_INVITE=

# Azure Storage account name used for off-site world backups (see valheim-offsite-backup.sh and
# valheim-offsite.timer). The VM's managed identity must have the "Storage Blob Data Reader"/
# "Storage Blob Data Contributor" role on this account -- no key or connection string is stored
# here or anywhere else. Leave empty to make the off-site backup scripts fail loudly (they will
# refuse to run without it) rather than silently write nowhere.
OFFSITE_ACCOUNT=

# UDP ports the game server listens on: the game port and the Steam A2S query port (game+1).
# These are the vanilla defaults and there is no reason to change them unless your ExecStart
# passes a different `-port`. They are read by valheim-meter-nft.sh (which builds the nftables
# counters and the peer set) and by valheim-egress-probe.py. Leave empty to use 2456/2457.
VALHEIM_GAME_PORT=
VALHEIM_QUERY_PORT=

# How long an address lingers in the nftables `peers` set after it stops sending, and how many
# addresses that set may hold. The collector reads the set to know who to ping; the egress probe
# compares its size against the player count to notice a join before status.json catches up. Keep
# the timeout short (a live client refreshes its entry tens of times a second) or departed players
# linger and make that check noisy. The size cap matters because the game port faces the internet:
# without it, every scanner that pokes the port sits in the set, and a spoofed-source flood is an
# unbounded kernel allocation. Empty means 2m / 256.
VALHEIM_PEER_TIMEOUT=
VALHEIM_PEER_MAX=

# How many days of 1 Hz egress samples valheim-egress-probe.py keeps in
# /var/lib/valheim-status/egress-YYYY-MM-DD.jsonl before unlinking whole days. Empty means 35 --
# deliberately longer than the 30-day window the investigation is described in terms of, because
# retention shorter than the experiment silently destroys its early weeks. About 1.5 MB a day, so
# 35 days is roughly 45 MB. A value that is not a plain integer (e.g. "30d") is refused with a
# warning in the journal rather than silently falling back.
EGRESS_RETAIN_DAYS=
